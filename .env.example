# --- Core ---
NODE_ENV=development
# Web origin allowed by CORS (student/vendor app URL)
FRONTEND_ORIGIN=http://localhost:3000
# Optional convenience variable for frontend deployments
BACKEND_ORIGIN=http://localhost:4000

# --- Backend ---
PORT=4000
# PostgreSQL connection string (UTC timestamps, paise storage)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mpstme_canteen?schema=public
# Redis for sessions, idempotency, queues, OTP cache
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace_with_min_32_characters_access_secret
JWT_REFRESH_SECRET=replace_with_min_32_characters_refresh_secret
# Used for CSRF cookie/header token signing
CSRF_SECRET=replace_with_csrf_secret
LOG_LEVEL=info

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
# Required for webhook HMAC verification
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# --- Storage (S3 or Supabase compatible) ---
STORAGE_PROVIDER=s3
S3_BUCKET=mpstme-receipts
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=replace_with_access_key
S3_SECRET_ACCESS_KEY=replace_with_secret
S3_ENDPOINT=

# --- Notifications ---
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# Used for OTP and fallback order-ready notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
